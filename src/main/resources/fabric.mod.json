{
  "schemaVersion": 1,
  "id": "solclient",
  "version": "${version}",
  "name": "Sol Client",
  "description": "Sol Client — NanoVG ClickGUI and HUD for Minecraft 1.21.11.",
  "authors": ["Sol Client"],
  "contributors": ["Original 67Client author (base code, used with permission)"],
  "license": "All-Rights-Reserved",
  "icon": "assets/solclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.sol.SolClient"],
    "fabric-client-gametest": [
      "dev.sol.gametest.PortedModulesGameTest",
      "dev.sol.gametest.AutoCrystalGameTest",
      "dev.sol.gametest.CustomGlintGameTest"
    ]
  },
  "mixins": ["solclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
